---
import Figure from './Figure.astro';
import TilearrayFigure from './figures/TilearrayFigure.astro';

interface Props {
  figureId?: string;
}

const { figureId } = Astro.props;
---

{figureId === 'tilearray' && (
  <Figure id="FIG. 01" caption="tilearray pipeline: plan requests, fetch and decode tiles, and assemble an array.">
    <TilearrayFigure />
  </Figure>
)}
