---
import Figure from './Figure.astro';
import TilearrayFigure from './figures/TilearrayFigure.astro';

interface Props {
  figureId?: string;
  title?: string;
}

const { figureId } = Astro.props;
---

{figureId === 'tilearray' && (
  <Figure id="FIG. 01" caption="The same goal, with and without a shared way to handle the service-specific work.">
    <TilearrayFigure />
  </Figure>
)}
