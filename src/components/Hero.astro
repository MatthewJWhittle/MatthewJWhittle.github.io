---
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__plane" aria-hidden="true">
    <div class="hero__field"></div>
    <svg class="hero__forms" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="land" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#c8d5c4" />
          <stop offset="45%" stop-color="#8fad8a" />
          <stop offset="100%" stop-color="#3d6b52" />
        </linearGradient>
        <linearGradient id="mist" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f9f8f5" stop-opacity="0.15" />
          <stop offset="55%" stop-color="#f9f8f5" stop-opacity="0.55" />
          <stop offset="100%" stop-color="#f9f8f5" stop-opacity="0.92" />
        </linearGradient>
      </defs>
      <path
        class="hero__ridge"
        d="M0 520 C180 480 260 620 420 560 S680 420 820 480 S1040 620 1200 540 L1200 900 L0 900 Z"
        fill="url(#land)"
        opacity="0.55"
      />
      <path
        class="hero__ridge hero__ridge--far"
        d="M0 420 C220 360 340 500 520 440 S780 300 960 380 S1120 460 1200 400 L1200 900 L0 900 Z"
        fill="#9bb89a"
        opacity="0.35"
      />
      <ellipse class="hero__glow" cx="860" cy="280" rx="220" ry="140" fill="#e8c48a" opacity="0.28" />
      <rect width="1200" height="900" fill="url(#mist)" />
    </svg>
  </div>

  <div class="wrap hero__content">
    <p class="hero__brand" id="hero-name">Matthew Whittle</p>
    <h1 class="hero__headline">Making sense of places with data, models, and care.</h1>
    <p class="hero__support">
      Applied data scientist and technical lead — ecology roots, geospatial ML, and analytics that
      people can trust.
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#work">See selected work</a>
      <a class="btn btn--ghost" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    align-items: end;
    overflow: clip;
    isolation: isolate;
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, #e7ebe3 0%, #f3efe8 42%, #dfe8dc 100%);
    transform: scale(1.04);
    animation: field-drift 18s var(--ease-out) both;
  }

  .hero__forms {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__ridge {
    transform-origin: 50% 100%;
    animation: ridge-settle 1.1s var(--ease-out) both;
  }

  .hero__ridge--far {
    animation-delay: 80ms;
  }

  .hero__glow {
    animation: glow-in 1.4s var(--ease-out) 200ms both;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(6rem, 16vh, 9rem) var(--space-6);
    max-width: 42rem;
  }

  .hero__brand {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
    color: var(--ink);
  }

  .hero__headline {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
  }

  .hero__support {
    margin: 0 0 var(--space-4);
    max-width: 34rem;
    color: var(--ink-muted);
    font-size: 1.125rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: #18563c;
    color: #fff;
  }

  .btn--ghost {
    background: rgba(255, 255, 255, 0.55);
    border-color: var(--line);
    color: var(--ink);
    backdrop-filter: blur(6px);
  }

  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @keyframes field-drift {
    from {
      transform: scale(1.08);
      filter: saturate(0.9);
    }
    to {
      transform: scale(1.02);
      filter: none;
    }
  }

  @keyframes ridge-settle {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field,
    .hero__ridge,
    .hero__glow {
      animation: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      align-items: center;
    }

    .hero__content {
      padding-block: var(--space-7);
    }
  }
</style>
