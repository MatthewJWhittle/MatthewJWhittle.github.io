---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/work/${project.id}/`;
const year = project.data.date.getFullYear();
---

<article class:list={['preview', featured && 'preview--featured']}>
  <div class="preview__copy">
    <p class="preview__meta">
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <span>{project.data.status}</span>
      {
        project.data.tags.slice(0, 3).map((tag) => (
          <>
            <span aria-hidden="true">·</span>
            <span>{tag}</span>
          </>
        ))
      }
    </p>
    <h3 class="preview__title">
      <a href={href}>{project.data.title}</a>
    </h3>
    <p class="preview__summary">{project.data.summary}</p>
    <p class="preview__link">
      <a href={href}>Read case study</a>
    </p>
  </div>
  {
    Astro.slots.has('figure') && (
      <div class="preview__figure">
        <slot name="figure" />
      </div>
    )
  }
</article>

<style>
  .preview {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--colour-rule);
  }

  .preview--featured {
    padding-block: var(--space-6);
  }

  .preview__meta {
    margin: 0 0 var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    color: var(--colour-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .preview__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .preview__title a {
    color: var(--colour-ink);
    text-decoration: none;
  }

  .preview__title a:hover {
    color: var(--colour-moss);
  }

  .preview__summary {
    margin: 0 0 var(--space-3);
    max-width: 40rem;
    color: var(--colour-muted);
  }

  .preview__link {
    margin: 0;
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .preview--featured {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-6);
      align-items: start;
    }
  }
</style>
