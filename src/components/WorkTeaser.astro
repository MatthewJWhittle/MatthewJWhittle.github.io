---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const year = project.data.date.getFullYear();
---

<article class="teaser">
  <p class="teaser__meta">
    <span>{year}</span>
    <span aria-hidden="true">·</span>
    <span>{project.data.status}</span>
  </p>
  <h3 class="teaser__title">{project.data.title}</h3>
  <p class="teaser__summary">{project.data.summary}</p>
</article>

<style>
  .teaser {
    padding-block: var(--space-4);
  }

  .teaser + .teaser {
    border-top: 1px solid var(--colour-rule);
  }

  .teaser__meta {
    margin: 0 0 var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    color: var(--colour-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .teaser__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .teaser__summary {
    margin: 0;
    max-width: 38rem;
    color: var(--colour-muted);
  }
</style>
