---
import { experience } from '../data/experience';
import '../styles/experience-timeline.css';
---

<div class="xtl">
  {
    experience.map(({ employer, logo, roles }) => (
      <section class="xtl__employer">
        <h3 class="xtl__org">
          {logo && (
            <img
              class="xtl__logo"
              src={logo.src}
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
          )}
          <span>{employer}</span>
        </h3>
        <ol class="xtl__roles" role="list">
          {roles.map(({ title, dates, overview, highlights }) => (
            <li class:list={['xtl__role', { 'xtl__role--brief': highlights.length === 1 }]}>
              <h4 class="xtl__title">{title}</h4>
              <p class="xtl__dates">{dates}</p>
              <div class="xtl__body">
                {overview && <p class="xtl__overview">{overview}</p>}
                <ul class="xtl__highlights" role="list">
                  {highlights.map(({ label, text, link }) => (
                    <li>
                      <p>{label && <><strong>{label}.</strong>{' '}</>}{text}</p>
                      {link && (
                        <a class="xtl__evidence" href={link.href}>
                          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
                            <path d={link.href.startsWith("/") ? "M3.5 3h6l3 3v7H3.5zM9.5 3v3h3M5.5 8.5h5M5.5 10.5h5" : "M6.5 4H3.5v8.5H12v-3M9 3.5h3.5V7M12 4l-6 6"} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span>{link.label}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>
