---
import { experience } from '../data/experience';
import '../styles/experience-timeline.css';
---

<div class="xtl">
  {
    experience.map(({ employer, logo, roles }) => (
      <section class="xtl__employer">
        <h3 class="xtl__org">
          {logo && (
            <img
              class="xtl__logo"
              src={logo.src}
              alt=""
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
            />
          )}
          <span>{employer}</span>
        </h3>
        <ol class="xtl__roles" role="list">
          {roles.map(({ title, dates, overview, highlights }) => (
            <li class="xtl__role">
              <div class="xtl__heading">
                <h4>{title}</h4>
                <p class="xtl__dates">{dates}</p>
              </div>
              {overview && <p class="xtl__overview">{overview}</p>}
              <ul class="xtl__highlights">
                {highlights.map(({ text, link }) => (
                  <li>
                    {text}
                    {link && <> <a href={link.href}>{link.label}</a></>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>
