---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const href = `/notes/${note.id}/`;
---

<article class="teaser">
  <p class="teaser__meta">{formatDate(note.data.date)}</p>
  <h3 class="teaser__title">
    <a href={href}>{note.data.title}</a>
  </h3>
  <p class="teaser__summary">{note.data.description}</p>
</article>

<style>
  .teaser {
    padding-block: var(--space-4);
  }

  .teaser + .teaser {
    border-top: 1px solid var(--colour-rule);
  }

  .teaser__meta {
    margin: 0 0 var(--space-2);
    color: var(--colour-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .teaser__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .teaser__title a {
    color: var(--colour-ink);
    text-decoration: none;
  }

  .teaser__title a:hover {
    color: var(--colour-moss);
  }

  .teaser__summary {
    margin: 0;
    max-width: 38rem;
    color: var(--colour-muted);
  }
</style>
