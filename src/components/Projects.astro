---
import HabitatExplorer from './demos/HabitatExplorer';
import RiskScreen from './demos/RiskScreen';
import TriageBoard from './demos/TriageBoard';
---

<section id="work" class="section projects">
  <div class="wrap">
    <p class="section__label reveal">Selected work</p>
    <h2 class="section__title reveal" data-delay="1">Projects with a pulse</h2>
    <p class="section__lede reveal" data-delay="2">
      Real engagements from SLR and earlier ecology practice — each paired with a small interactive
      sketch so the idea is felt, not only listed. Production systems stay behind the curtain.
    </p>

    <div class="projects__list">
      <article class="project reveal" data-delay="1" id="habitat-mapping">
        <div class="project__copy">
          <p class="project__meta">SLR Consulting · Geospatial ML</p>
          <h3 class="project__title">Intelligent UK Habitat Mapping</h3>
          <p class="project__blurb">
            Designed and built an end-to-end PyTorch Vision Transformer habitat-mapping service —
            imagery processing, training data, tiled inference, Azure ML — from proof of concept to
            live site use across nine upland/afforestation sites covering over 2,000 hectares, with
            ecologist QA. Semi-automated support for baselines, not a finished self-serve product.
          </p>
        </div>
        <div class="project__demo">
          <HabitatExplorer client:visible />
        </div>
      </article>

      <article class="project reveal" data-delay="2" id="book-chain">
        <div class="project__copy">
          <p class="project__meta">SLR Consulting · API / due diligence</p>
          <h3 class="project__title">Book Chain EUDR risk API</h3>
          <p class="project__blurb">
            Led design and implementation of a deforestation-risk API for publishing supply-chain
            due diligence: FastAPI, PostgreSQL, Azure Container Apps, geospatial validation and risk
            screening (~170 automated tests). Integration progressed through 2025; wider production
            adoption is still being verified — described here as delivered engineering, not a market
            claim.
          </p>
        </div>
        <div class="project__demo">
          <RiskScreen client:visible />
        </div>
      </article>

      <article class="project reveal" data-delay="3" id="camera-triage">
        <div class="project__copy">
          <p class="project__meta">SLR Consulting · Computer vision</p>
          <h3 class="project__title">Camera-trap triage</h3>
          <p class="project__blurb">
            Led a SpeciesNet-based video triage workflow for a client study — 60 cameras across
            ~260 km², screening 8,924 videos and shortlisting around 1,600 for expert review.
            Triage for specialists; not a claim of reliable automated species identification.
          </p>
        </div>
        <div class="project__demo">
          <TriageBoard client:visible />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .projects__list {
    display: grid;
    gap: var(--space-6);
  }

  .project {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .project__meta {
    margin: 0 0 var(--space-2);
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .project__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .project__blurb {
    margin: 0;
    max-width: 38rem;
    color: var(--ink-muted);
  }

  .project__demo {
    max-width: 36rem;
  }

  @media (min-width: 960px) {
    .project {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-5);
      align-items: start;
    }
  }
</style>
