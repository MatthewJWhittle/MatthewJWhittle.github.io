---
import QuietLayout from './QuietLayout.astro';

interface Props {
  title: string;
  description: string;
  meta?: string;
  /** Parent route; project articles default to the projects index. */
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  meta,
  backHref = '/work/',
  backLabel = '← Projects',
} = Astro.props;
---

<QuietLayout
  title={title}
  description={description}
  meta={meta}
  lede={description}
  as="article"
  backHref={backHref}
  backLabel={backLabel}
>
  <div class="prose article__body">
    <slot />
  </div>
</QuietLayout>

<style>
  /* Text stays on the reading measure. Figures use the full article width,
     which is already inset by the page gutter. */
  .article__body {
    max-width: none;
  }

  .article__body > :global(p),
  .article__body > :global(h2),
  .article__body > :global(h3),
  .article__body > :global(ul),
  .article__body > :global(ol),
  .article__body > :global(blockquote) {
    max-width: var(--measure);
  }
</style>
