---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page is not in this notebook.">
  <section class="section wrap">
    <p class="section__label">404</p>
    <h1 class="section__title">Nothing filed under that path</h1>
    <p class="section__lede">
      The page may have moved, or the link may be wrong. Try the indexes below.
    </p>
    <p>
      <a href="/">Home</a>
      <span aria-hidden="true"> · </span>
      <a href="/work/">Work</a>
      <span aria-hidden="true"> · </span>
      <a href="/notes/">Notes</a>
      <span aria-hidden="true"> · </span>
      <a href="/about/">About</a>
    </p>
  </section>
</BaseLayout>
