---
import QuietLayout from '../../layouts/QuietLayout.astro';
import CvOverview from '../../components/CvOverview.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import { site } from '../../data/site';
---

<QuietLayout
  title="CV"
  heading={site.name}
  tagline={site.headline}
  description={`CV for ${site.name}, covering ecology, data science, software and analytics leadership.`}
  lede="I started my career as an ecologist and got into data science through the problems I encountered on projects. I now lead data and analytics at SLR Consulting, having spent much of my career building models, software and technical teams. I’m particularly interested in how we can use computing to better understand the natural world, and I’ve learnt that understanding the problem is as important as the technology we use to solve it."
  headerRule={false}
>
  <div class="cv-content">
    <p class="cv-profile-links">
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={`mailto:${site.email}`}>Email</a>
      <span class="cv-profile-links__location">
        <svg
          class="cv-profile-links__pin"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M8 14l-4-4.5a5 5 0 119 0L8 14zm0-6.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {site.location}
      </span>
    </p>
    <CvOverview />

    <nav class="cv-jump" aria-label="On this page">
      <a href="#experience-heading">Experience</a>
      <a href="#projects-heading">Independent projects</a>
      <a href="#education-heading">Education and recognition</a>
    </nav>

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <ExperienceTimeline />
    </section>

    <section class="cv-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Selected independent projects</h2>
      <div class="cv-projects">
        <article class="cv-project">
          <div>
            <p class="cv-project__meta">Ecology · Spatial modelling · Machine learning</p>
            <h3><a href="/work/bat-habitat-yorkshire/">Modelling bat habitat suitability across Yorkshire</a></h3>
            <p>A long-running collaboration with Greg Slack exploring how species records and environmental data can inform ecological assessments. We’ve built a reusable MaxEnt modelling workflow and interactive maps of predicted habitat suitability across Yorkshire.</p>
            <p class="cv-project__links">
              <a href="https://github.com/MatthewJWhittle/shefflied-bats">Modelling code</a>
            </p>
          </div>
          <figure>
            <img src="/images/hsm/panel-daubenton-if.webp" alt="Modelled habitat suitability for Daubenton’s bat across Yorkshire, with higher scores along waterways." width="781" height="629" loading="lazy" decoding="async" />
            <figcaption>Predicted suitability · Daubenton’s bat</figcaption>
          </figure>
        </article>
        <article class="cv-project">
          <div>
            <p class="cv-project__meta">Python · Geospatial data engineering · Open source</p>
            <h3><a href="/work/tilearray/">tilearray</a></h3>
            <p>Getting raster data out of web map services can be surprisingly cumbersome. I built this open-source Python library to handle tile planning, fetching and mosaicking, returning Dask-backed xarray arrays for analysis and machine learning. Currently in alpha.</p>
            <p class="cv-project__links">
              <a href="https://github.com/MatthewJWhittle/tilearray">Source code</a>
              <a href="https://matthewjwhittle.github.io/tilearray/">Documentation</a>
            </p>
          </div>
          <figure>
            <img src="/images/tilearray/fig01-hero-desktop.webp" alt="Aerial image around the Golden Gate with a selected area shown as an enlarged image patch." width="1400" height="720" loading="lazy" decoding="async" />
            <figcaption>USGS / USDA NAIP · public domain</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education and recognition</h2>
      <ul>
        <li>BSc (Hons) Zoology / Animal Biology (2:1), Newcastle University, 2011–2014.</li>
        <li>
          <a href="https://environment-analyst.com/global/108271/sustainability-consulting-awards-shortlist-announced">Rising Star Award shortlist</a>,
          Environment Analyst Sustainability Consulting Awards, 2022.
        </li>
      </ul>
    </section>
  </div>
</QuietLayout>

<style>
  .cv-content {
    max-width: 60rem;
  }

  .cv-profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0 0 var(--space-3);
    color: var(--colour-muted);
    font-size: 0.9rem;
  }

  .cv-profile-links__location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .cv-profile-links__pin {
    flex: 0 0 auto;
    color: var(--colour-moss);
  }

  .cv-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    padding-block: var(--space-3);
    margin-bottom: var(--space-6);
    border-block: 1px solid var(--colour-rule);
    font-size: 0.9rem;
  }

  .cv-jump a {
    color: var(--colour-muted);
  }

  .cv-jump a:hover {
    color: var(--colour-ink);
  }

  h2 {
    scroll-margin-top: 1.5rem;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-rule);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .cv-section {
    padding-block: var(--space-6) var(--space-5);
  }

  .cv-projects {
    display: grid;
    gap: var(--space-5);
  }

  .cv-project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    min-width: 0;
  }

  .cv-project + .cv-project {
    border-top: 1px solid var(--colour-rule);
    padding-top: var(--space-5);
  }

  .cv-project figure {
    margin: 0;
    max-width: 18rem;
  }

  .cv-project img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--colour-rule);
  }

  .cv-project figcaption {
    color: var(--colour-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    margin-top: var(--space-1);
  }

  .cv-project h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .cv-project h3 a {
    color: var(--colour-ink);
    text-decoration-color: var(--colour-rule);
  }

  .cv-project h3 a:hover {
    color: var(--colour-moss);
  }

  .cv-project p {
    margin: 0;
    max-width: var(--measure);
  }

  .cv-project .cv-project__meta {
    margin-bottom: var(--space-1);
    color: var(--colour-muted);
    font-size: 0.78rem;
  }

  .cv-project .cv-project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: var(--space-2);
    font-size: 0.9rem;
  }

  @media (max-width: 39.999rem) {
    .cv-project figure {
      display: grid;
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
      gap: var(--space-3);
      align-items: center;
      max-width: none;
    }
  }

  @media (min-width: 40rem) {
    .cv-project {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-5);
    }

    .cv-project > div {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
    }

    .cv-project figure {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (min-width: 64rem) {
    .cv-project {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .cv-section ul {
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .cv-section li + li {
    margin-top: 0.3em;
  }
</style>
