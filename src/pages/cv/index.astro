---
import QuietLayout from '../../layouts/QuietLayout.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import { site } from '../../data/site';
---

<QuietLayout
  title="CV"
  heading={site.name}
  tagline={site.headline}
  description={`CV for ${site.name}, covering ecology, data science, software and analytics leadership.`}
  lede="I started my career as an ecologist, writing code to make better use of the data we collected in the field. These days I lead analytics at SLR Consulting, but I’m still particularly interested in using software and machine learning to understand environmental systems. For me, understanding the problem and the science behind it matters as much as the technology."
  headerRule={false}
>
  <div class="cv-content">
    <p class="cv-profile-links">
      <span>{site.location}</span>
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </p>

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <ExperienceTimeline />
    </section>

    <section class="cv-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Selected independent projects</h2>
      <ul>
        <li>
          <a href="/work/bat-habitat-yorkshire/">Modelling bat habitat suitability across Yorkshire</a>.
          An ongoing collaboration with Greg Slack to model bat habitat suitability from species records and environmental data. We use MaxEnt to produce habitat suitability maps and have been developing a reusable modelling workflow. <a href="https://github.com/MatthewJWhittle/shefflied-bats">Modelling code</a>.
        </li>
        <li>
          <a href="/work/tilearray/">tilearray</a>.
          An open-source Python library for turning remote geospatial tile services into Dask-backed xarray arrays. I built it to make getting imagery into analysis and machine learning workflows easier. It is currently in alpha. <a href="https://github.com/MatthewJWhittle/tilearray">Source code</a> · <a href="https://matthewjwhittle.github.io/tilearray/">Documentation</a>.
        </li>
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education and recognition</h2>
      <ul>
        <li>BSc (Hons) Zoology / Animal Biology, Newcastle University, 2011–2014.</li>
        <li>
          <a href="https://environment-analyst.com/global/108271/sustainability-consulting-awards-shortlist-announced">Rising Star Award shortlist</a>,
          Environment Analyst Sustainability Consulting Awards, 2022.
        </li>
      </ul>
    </section>
  </div>
</QuietLayout>

<style>
  .cv-content {
    max-width: var(--measure);
  }

  .cv-profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0 0 var(--space-6);
    color: var(--colour-muted);
    font-size: 0.9rem;
  }

  h2 {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-rule);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .cv-section {
    padding-block: var(--space-5);
  }

  .cv-section ul {
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .cv-section li + li {
    margin-top: 0.3em;
  }
</style>
