---
import QuietLayout from '../../layouts/QuietLayout.astro';
import CvOverview from '../../components/CvOverview.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import { site } from '../../data/site';
---

<QuietLayout
  title="CV"
  heading={site.name}
  tagline={site.headline}
  description={`CV for ${site.name}, covering ecology, data science, software and analytics leadership.`}
  lede="I started my career as an ecologist, writing code to make better use of the data we collected in the field. These days I lead analytics at SLR Consulting, but I’m still particularly interested in using software and machine learning to understand environmental systems. For me, understanding the problem and the science behind it matters as much as the technology."
  headerRule={false}
>
  <div class="cv-content">
    <CvOverview />

    <section aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <ExperienceTimeline />
    </section>

    <section class="cv-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects outside work</h2>
      <ul>
        <li>
          <a href="/work/bat-habitat-yorkshire/">Modelling bat habitat suitability across Yorkshire</a>.
          An ongoing collaboration with Greg Slack exploring what we can learn about bat habitat from species records and environmental data, and how we can make the resulting models useful to ecologists.
        </li>
        <li>
          <a href="/work/tilearray/">tilearray</a>.
          An open-source Python library for bringing remotely hosted geospatial imagery and raster data into Python as arrays, without having to manage individual map tiles.
        </li>
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education and recognition</h2>
      <ul>
        <li>BSc (Hons) Zoology / Animal Biology, Newcastle University, 2011–2014.</li>
        <li>
          <a href="https://environment-analyst.com/global/108271/sustainability-consulting-awards-shortlist-announced">Rising Star Award shortlist</a>,
          Environment Analyst Sustainability Consulting Awards, 2022.
        </li>
      </ul>
    </section>
  </div>
</QuietLayout>

<style>
  .cv-content {
    max-width: var(--measure);
  }

  h2 {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-rule);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .cv-section {
    padding-block: var(--space-5);
  }

  .cv-section ul {
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .cv-section li + li {
    margin-top: 0.3em;
  }
</style>
