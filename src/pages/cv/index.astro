---
import QuietLayout from '../../layouts/QuietLayout.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import { site } from '../../data/site';
---

<QuietLayout
  title="CV"
  description={`Professional experience for ${site.name}. Role history with employer, title and start dates.`}
  lede="Professional experience. Expand a role for more detail."
>
  <section
    id="experience"
    class="cv-experience"
    aria-labelledby="experience-heading"
  >
    <h2 id="experience-heading" class="cv-experience__title">Experience</h2>
    <ExperienceTimeline />
  </section>
</QuietLayout>

<style>
  .cv-experience {
    max-width: var(--measure);
  }

  .cv-experience__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
</style>
