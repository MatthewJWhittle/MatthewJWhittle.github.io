---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotePreview from '../../components/NotePreview.astro';
import { getPublishedNotes } from '../../lib/content';

const notes = await getPublishedNotes();
---

<BaseLayout title="Notes" description="Short field notes on building tools and shipping ML.">
  <section class="section wrap">
    <p class="section__label">Notes</p>
    <h1 class="section__title">Field notes</h1>
    <p class="section__lede">Chronological short writing — observation, explanation, what changed.</p>
    <div>
      {notes.map((note) => <NotePreview note={note} />)}
    </div>
  </section>
</BaseLayout>
