---
import QuietLayout from '../../layouts/QuietLayout.astro';
import NoteTeaser from '../../components/NoteTeaser.astro';
import { getPublishedNotes } from '../../lib/content';

const notes = await getPublishedNotes();
---

<QuietLayout title="Notes" description="Short notes.">
  {
    notes.length === 0 ? (
      <p class="muted">Coming soon.</p>
    ) : (
      <div>
        {notes.map((note) => (
          <NoteTeaser note={note} />
        ))}
      </div>
    )
  }
</QuietLayout>

<style>
  .muted {
    margin: 0;
    color: var(--colour-muted);
  }
</style>
