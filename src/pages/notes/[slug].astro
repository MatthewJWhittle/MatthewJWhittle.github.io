---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { formatDate, getPublishedNotes } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = `${formatDate(entry.data.date)}${entry.data.tags.length ? ` · ${entry.data.tags.join(' · ')}` : ''}`;
---

<ArticleLayout title={entry.data.title} description={entry.data.description} meta={meta}>
  <Content />
  <p class="note-back"><a href="/notes/">← All notes</a></p>
</ArticleLayout>

<style>
  .note-back {
    margin-top: 2.5rem;
  }
</style>
