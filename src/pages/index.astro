---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav';
import WorkTeaser from '../components/WorkTeaser.astro';
import NoteTeaser from '../components/NoteTeaser.astro';
import { site } from '../data/site';
import { getPublishedNotes, getPublishedWork } from '../lib/content';

const TEASER_CAP = 3;
const allWork = await getPublishedWork();
const allNotes = await getPublishedNotes();
const workTeasers = allWork.slice(0, TEASER_CAP);
const noteTeasers = allNotes.slice(0, TEASER_CAP);
const showAllWork = allWork.length > TEASER_CAP;
const showAllNotes = allNotes.length > TEASER_CAP;
---

<BaseLayout>
  <div class="shell">
    <aside class="shell__nav" aria-label="Section navigation">
      <SectionNav client:load />
    </aside>

    <main id="main" class="shell__main">
      <section id="about" class="block" aria-labelledby="about-heading">
        <p class="section__label">About</p>
        <h1 id="about-heading" class="block__title">{site.name}</h1>
        <p class="block__lede">{site.headline}</p>
        <div class="prose">
          {site.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section id="work" class="block" aria-labelledby="work-heading">
        <p class="section__label">Work</p>
        <h2 id="work-heading" class="block__title">Projects</h2>
        {
          workTeasers.length === 0 ? (
            <>
              <p class="block__lede">Coming soon.</p>
              <p class="muted">Case studies will appear here when they're ready.</p>
            </>
          ) : (
            <div class="teaser-list">
              {workTeasers.map((project) => (
                <WorkTeaser project={project} />
              ))}
            </div>
          )
        }
        {
          showAllWork && (
            <p class="section-more">
              <a href="/work/">All work →</a>
            </p>
          )
        }
      </section>

      <section id="notes" class="block" aria-labelledby="notes-heading">
        <p class="section__label">Notes</p>
        <h2 id="notes-heading" class="block__title">Notes</h2>
        {
          noteTeasers.length === 0 ? (
            <>
              <p class="block__lede">Coming soon.</p>
              <p class="muted">Short writing will appear here later.</p>
            </>
          ) : (
            <div class="teaser-list">
              {noteTeasers.map((note) => (
                <NoteTeaser note={note} />
              ))}
            </div>
          )
        }
        {
          showAllNotes && (
            <p class="section-more">
              <a href="/notes/">All notes →</a>
            </p>
          )
        }
      </section>

      <section id="contact" class="block" aria-labelledby="contact-heading">
        <p class="section__label">Contact</p>
        <h2 id="contact-heading" class="block__title">Get in touch</h2>
        <ul class="contact-list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.github}>GitHub</a></li>
        </ul>
        <p class="footer-meta">© {new Date().getFullYear()} {site.name}</p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100vh;
  }

  .shell__nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--colour-paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--colour-rule);
  }

  .shell__main {
    padding-inline: var(--gutter);
    padding-block: var(--space-5) var(--space-8);
    max-width: calc(var(--measure) + var(--gutter) * 2);
  }

  .block {
    padding-block: var(--space-7);
    scroll-margin-top: 5.5rem;
  }

  .block + .block {
    border-top: 1px solid var(--colour-rule);
  }

  .block__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .block__lede {
    margin: 0 0 var(--space-5);
    max-width: var(--measure);
    color: var(--colour-muted);
    font-size: 1.125rem;
  }

  .muted {
    margin: 0;
    color: var(--colour-muted);
  }

  .teaser-list {
    margin-top: var(--space-2);
  }

  .section-more {
    margin: var(--space-4) 0 0;
    font-weight: 500;
  }

  .contact-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    font-weight: 500;
    font-size: 1.1rem;
  }

  .footer-meta {
    margin: var(--space-7) 0 0;
    color: var(--colour-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* Desktop: fixed left nav — always one click to Contact */
  @media (min-width: 860px) {
    .shell {
      position: relative;
      max-width: var(--max-page);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .shell__nav {
      position: fixed;
      top: 0;
      /* Align with shell left edge when page is centered */
      left: max(var(--gutter), calc((100vw - var(--max-page)) / 2 + var(--gutter)));
      width: 11.5rem;
      height: 100vh;
      z-index: 30;
      border-bottom: 0;
      background: var(--colour-paper);
      backdrop-filter: none;
      padding-block: var(--space-7) var(--space-5);
      overflow-y: auto;
    }

    .shell__main {
      margin-left: calc(11.5rem + var(--space-6));
      padding-inline: 0;
      padding-block: var(--space-7) var(--space-8);
      max-width: none;
    }

    .block {
      scroll-margin-top: var(--space-6);
      padding-block: var(--space-8);
    }

    .block:first-child {
      padding-top: var(--space-7);
    }
  }
</style>
