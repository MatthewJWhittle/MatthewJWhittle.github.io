---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import WorkTeaser from '../components/WorkTeaser.astro';
import { site } from '../data/site';
import { getPublishedWork } from '../lib/content';

const TEASER_CAP = 6;
const allWork = await getPublishedWork();
const workTeasers = allWork.slice(0, TEASER_CAP);
const showAllWork = allWork.length > TEASER_CAP;
---

<BaseLayout>
  <div class="shell">
    <aside class="shell__nav" aria-label="Section navigation">
      <SectionNav client:load />
    </aside>

    <main id="main" class="shell__main">
      <section id="about" class="block" aria-labelledby="about-heading">
        <h1 id="about-heading" class="block__title">{site.name}</h1>
        <p class="block__lede">{site.headline}</p>
        <div class="prose">
          <p>{site.about}</p>
        </div>
        <ul class="about-links">
          <li>
            <a class="about-links__mail" href={`mailto:${site.email}`} aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={site.linkedin} aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.7 3.4a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2zM3.1 9.1h3.2V21H3.1V9.1zm5.8 0h3.1v1.6h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5V21h-3.2v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H8.9V9.1z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={site.github} aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </section>

      <section id="projects" class="block" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="block__title">Projects</h2>
        <p class="block__lede">
          Things I've built, worked on or learnt something from.
        </p>
        {
          workTeasers.length === 0 ? (
            <p class="muted">Nothing published yet.</p>
          ) : (
            <div class="teaser-list">
              {workTeasers.map((project) => (
                <WorkTeaser project={project} />
              ))}
            </div>
          )
        }
        {
          showAllWork && (
            <p class="section-more">
              <a href="/work/">All projects →</a>
            </p>
          )
        }
      </section>

      <section id="experience" class="block" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="block__title">Experience</h2>
        <ExperienceTimeline />
      </section>

      <section id="contact" class="block" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="block__title">Get in touch</h2>
        <ul class="contact-list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.github}>GitHub</a></li>
        </ul>
        <p class="footer-meta">© {new Date().getFullYear()} {site.name}</p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100vh;
  }

  .shell__nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--colour-paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--colour-rule);
  }

  .shell__main {
    padding-inline: var(--gutter);
    padding-block: var(--space-5) var(--space-8);
    max-width: calc(var(--measure) + var(--gutter) * 2);
  }

  .block {
    padding-block: var(--space-7);
    scroll-margin-top: 5.5rem;
  }

  .block + .block {
    border-top: 1px solid var(--colour-rule);
  }

  .block__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .block__lede {
    margin: 0 0 var(--space-5);
    max-width: var(--measure);
    color: var(--colour-muted);
    font-size: 1.125rem;
  }

  .muted {
    margin: 0;
    color: var(--colour-muted);
  }

  .teaser-list {
    margin-top: var(--space-2);
  }

  .about-links {
    display: flex;
    gap: 0.35rem;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    color: var(--colour-muted);
  }

  .about-links a:hover {
    color: var(--colour-ink);
  }

  .about-links svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
    stroke: none;
  }

  .about-links__mail svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .section-more {
    display: flex;
    gap: 1rem;
    margin: var(--space-4) 0 0;
    font-weight: 500;
  }

  .contact-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    font-weight: 500;
    font-size: 1.1rem;
  }

  .footer-meta {
    margin: var(--space-7) 0 0;
    color: var(--colour-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (min-width: 860px) {
    .shell {
      position: relative;
      max-width: var(--max-page);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .shell__nav {
      position: fixed;
      top: 0;
      left: max(var(--gutter), calc((100vw - var(--max-page)) / 2 + var(--gutter)));
      width: 11.5rem;
      height: 100vh;
      z-index: 30;
      border-bottom: 0;
      background: var(--colour-paper);
      backdrop-filter: none;
      padding-block: var(--space-7) var(--space-5);
      overflow-y: auto;
    }

    .shell__main {
      margin-left: calc(11.5rem + var(--space-6));
      padding-inline: 0;
      padding-block: var(--space-7) var(--space-8);
      max-width: none;
    }

    .block {
      scroll-margin-top: var(--space-6);
      padding-block: var(--space-8);
    }

    .block:first-child {
      padding-top: var(--space-7);
    }
  }
</style>
