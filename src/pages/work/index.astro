---
import QuietLayout from '../../layouts/QuietLayout.astro';
import WorkTeaser from '../../components/WorkTeaser.astro';
import { getPublishedWork } from '../../lib/content';

const work = await getPublishedWork();
---

<QuietLayout
  title="Projects"
  description="Selected projects and notes on things I have built."
>
  {
    work.length === 0 ? (
      <p class="muted">Coming soon.</p>
    ) : (
      <div class="teaser-list">
        {work.map((project) => (
          <WorkTeaser project={project} />
        ))}
      </div>
    )
  }

  <p class="quiet__related" slot="after">
    <a href="/cv/">CV →</a>
  </p>
</QuietLayout>

<style>
  .muted {
    margin: 0;
    color: var(--colour-muted);
  }

  .teaser-list {
    margin-top: 0;
  }
</style>
