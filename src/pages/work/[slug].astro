---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import { getPublishedWork } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = `Started ${entry.data.startedYear}${entry.data.tags.length ? ` · ${entry.data.tags.join(' · ')}` : ""}`;
const hasLinks = Boolean(entry.data.repositoryUrl || entry.data.docsUrl || entry.data.demoUrl);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const personId = new URL('#person', Astro.site).href;
const isSoftware = entry.id === 'tilearray';
const relatedUrls = [
  !isSoftware ? entry.data.repositoryUrl : undefined,
  entry.data.docsUrl,
  entry.data.demoUrl,
].filter((url): url is string => Boolean(url));

/** Project schema only from verified frontmatter / page facts — no invented claims. */
const projectSchema: Record<string, unknown> | undefined =
  entry.data.repositoryUrl || entry.data.docsUrl || entry.data.demoUrl
    ? {
        '@type': isSoftware ? 'SoftwareSourceCode' : 'CreativeWork',
        '@id': `${pageUrl}#project`,
        name: entry.data.title,
        description: entry.data.summary,
        url: pageUrl,
        dateCreated: String(entry.data.startedYear),
        author: { '@id': personId },
        ...(isSoftware && entry.data.repositoryUrl
          ? {
              codeRepository: entry.data.repositoryUrl,
              programmingLanguage: 'Python',
              license: 'https://www.apache.org/licenses/LICENSE-2.0',
            }
          : {}),
        ...(relatedUrls.length ? { sameAs: relatedUrls } : {}),
        ...(entry.data.tags.length
          ? { keywords: entry.data.tags.join(', ') }
          : {}),
      }
    : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  meta={meta}
  structuredData={projectSchema}
>
  {
    hasLinks && (
      <p class="case-links case-links--top">
        {entry.data.repositoryUrl && (
          <a href={entry.data.repositoryUrl} target="_blank" rel="noopener noreferrer">
            Source repository
          </a>
        )}
        {entry.data.docsUrl && (
          <a href={entry.data.docsUrl} target="_blank" rel="noopener noreferrer">
            Documentation
          </a>
        )}
        {entry.data.demoUrl && (
          <a href={entry.data.demoUrl} target="_blank" rel="noopener noreferrer">
            {entry.data.demoLabel ?? "Live demo"}
          </a>
        )}
      </p>
    )
  }
  {
    entry.data.figureId && (
      <div class="case-figure">
        <ProjectFigure figureId={entry.data.figureId} title={entry.data.title} />
      </div>
    )
  }
  <Content />
</ArticleLayout>

<style>
  .case-figure {
    margin-bottom: 2rem;
    width: 100%;
    max-width: none;
    margin-left: 0;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-weight: 500;
  }

  .case-links--top {
    margin: 0 0 1.75rem;
  }
</style>
